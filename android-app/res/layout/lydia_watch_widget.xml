<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Watchlist: i titoli seguiti, con prezzo e andamento di oggi. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/wl_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/lydia_widget_bg" android:scaleType="fitXY" android:importantForAccessibility="no" />
<LinearLayout
    android:id="@+id/wl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_marginEnd="8dp" android:src="@mipmap/ic_launcher_round" android:contentDescription="Lydia" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Watchlist" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/wl_upd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="11.5sp" android:maxLines="1" />
        <ImageView android:id="@+id/wl_ref" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="8dp" android:background="@drawable/lydia_eye_bg" android:padding="7dp" android:src="@drawable/lydia_ic_refresh" android:contentDescription="Aggiorna i prezzi" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:background="@color/lydia_w_line" />
    <TextView android:id="@+id/wl_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Aggiungi un titolo alla watchlist in Patrimonio" android:textColor="@color/lydia_w_muted" android:textSize="13sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/wl_r1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/wl_n1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/wl_m1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="10.5sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/wl_p1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="84dp" android:layout_marginStart="8dp" android:gravity="end" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:maxLines="1" />
        <TextView android:id="@+id/wl_d1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="68dp" android:layout_marginStart="8dp" android:gravity="end" android:textColor="@color/lydia_w_muted" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wl_r2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/wl_n2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/wl_m2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="10.5sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/wl_p2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="84dp" android:layout_marginStart="8dp" android:gravity="end" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:maxLines="1" />
        <TextView android:id="@+id/wl_d2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="68dp" android:layout_marginStart="8dp" android:gravity="end" android:textColor="@color/lydia_w_muted" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wl_r3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/wl_n3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/wl_m3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="10.5sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/wl_p3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="84dp" android:layout_marginStart="8dp" android:gravity="end" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:maxLines="1" />
        <TextView android:id="@+id/wl_d3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="68dp" android:layout_marginStart="8dp" android:gravity="end" android:textColor="@color/lydia_w_muted" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wl_r4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/wl_n4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/wl_m4" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="10.5sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/wl_p4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="84dp" android:layout_marginStart="8dp" android:gravity="end" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:maxLines="1" />
        <TextView android:id="@+id/wl_d4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="68dp" android:layout_marginStart="8dp" android:gravity="end" android:textColor="@color/lydia_w_muted" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wl_r5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/wl_n5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/wl_m5" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="10.5sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/wl_p5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="84dp" android:layout_marginStart="8dp" android:gravity="end" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:maxLines="1" />
        <TextView android:id="@+id/wl_d5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="68dp" android:layout_marginStart="8dp" android:gravity="end" android:textColor="@color/lydia_w_muted" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
