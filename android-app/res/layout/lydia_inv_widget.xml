<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Investimenti: valore e guadagno in alto, poi un titolo per riga con oggi e guadagno. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/iv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/lydia_widget_bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/iv_logo" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginEnd="8dp" android:src="@mipmap/ic_launcher_round" android:contentDescription="Lydia" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Investimenti" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/iv_upd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="11.5sp" android:maxLines="1" />
        <ImageView android:id="@+id/iv_ref" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="8dp" android:background="@drawable/lydia_eye_bg" android:padding="7dp" android:src="@drawable/lydia_ic_refresh" android:contentDescription="Aggiorna i prezzi" />
        <ImageView android:id="@+id/iv_eye" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="8dp" android:background="@drawable/lydia_eye_bg" android:padding="8dp" android:src="@drawable/lydia_ic_eye" android:visibility="gone" android:contentDescription="Mostra gli importi" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
        <TextView android:id="@+id/iv_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/lydia_w_text" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
        <TextView android:id="@+id/iv_gain" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginBottom="3dp" android:gravity="end" android:textColor="@color/lydia_w_muted" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:background="@color/lydia_w_line" />
    <LinearLayout android:id="@+id/iv_r1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/iv_n1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/iv_m1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="10.5sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="84dp" android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/iv_p1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:maxLines="1" />
            <TextView android:id="@+id/iv_d1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="10.5sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="80dp" android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/iv_g1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/iv_q1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="10.5sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/iv_r2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/iv_n2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/iv_m2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="10.5sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="84dp" android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/iv_p2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:maxLines="1" />
            <TextView android:id="@+id/iv_d2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="10.5sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="80dp" android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/iv_g2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/iv_q2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="10.5sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/iv_r3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/iv_n3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/iv_m3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="10.5sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="84dp" android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/iv_p3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:maxLines="1" />
            <TextView android:id="@+id/iv_d3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="10.5sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="80dp" android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/iv_g3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/iv_q3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="10.5sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/iv_r4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/iv_n4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/iv_m4" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="10.5sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="84dp" android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/iv_p4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_text" android:textSize="15sp" android:maxLines="1" />
            <TextView android:id="@+id/iv_d4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="10.5sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="80dp" android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/iv_g4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/iv_q4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="10.5sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
