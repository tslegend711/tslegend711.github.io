<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Investimenti: valore e guadagno in alto, poi un titolo per riga con oggi e guadagno. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/iv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/lydia_widget_bg"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Investimenti" android:textColor="@color/lydia_w_muted" android:textSize="12sp" android:letterSpacing="0.02" />
        <TextView android:id="@+id/iv_upd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="11sp" android:maxLines="1" />
        <ImageView android:id="@+id/iv_eye" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="8dp" android:background="@drawable/lydia_eye_bg" android:padding="7dp" android:src="@drawable/lydia_ic_eye" android:visibility="gone" android:contentDescription="Mostra gli importi" />
    </LinearLayout>

    <TextView android:id="@+id/iv_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="—" android:textColor="@color/lydia_w_text" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    <TextView android:id="@+id/iv_gain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lydia_w_muted" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="@color/lydia_w_line" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Titolo" android:textColor="@color/lydia_w_muted" android:textSize="10sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="62dp" android:gravity="end" android:text="Oggi" android:textColor="@color/lydia_w_muted" android:textSize="10sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="78dp" android:gravity="end" android:text="Guadagno" android:textColor="@color/lydia_w_muted" android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/iv_r1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/iv_n1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/lydia_w_text" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/iv_d1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="62dp" android:gravity="end" android:textColor="@color/lydia_w_muted" android:textSize="12sp" android:maxLines="1" />
        <TextView android:id="@+id/iv_g1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="78dp" android:gravity="end" android:textColor="@color/lydia_w_muted" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/iv_r2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/iv_n2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/lydia_w_text" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/iv_d2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="62dp" android:gravity="end" android:textColor="@color/lydia_w_muted" android:textSize="12sp" android:maxLines="1" />
        <TextView android:id="@+id/iv_g2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="78dp" android:gravity="end" android:textColor="@color/lydia_w_muted" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/iv_r3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/iv_n3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/lydia_w_text" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/iv_d3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="62dp" android:gravity="end" android:textColor="@color/lydia_w_muted" android:textSize="12sp" android:maxLines="1" />
        <TextView android:id="@+id/iv_g3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="78dp" android:gravity="end" android:textColor="@color/lydia_w_muted" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/iv_r4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/iv_n4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/lydia_w_text" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/iv_d4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="62dp" android:gravity="end" android:textColor="@color/lydia_w_muted" android:textSize="12sp" android:maxLines="1" />
        <TextView android:id="@+id/iv_g4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="78dp" android:gravity="end" android:textColor="@color/lydia_w_muted" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
