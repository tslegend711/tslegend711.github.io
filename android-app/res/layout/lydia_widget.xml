<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Movimenti: una riga. Logo e saldo del mese a sinistra, tre pulsanti a destra. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/lydia_widget_bg"
    android:paddingStart="10dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="Lydia" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E3BC4A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1" />
        <TextView
            android:id="@+id/w_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_out"
        android:layout_width="44dp"
        android:layout_height="40dp"
        android:background="@drawable/lydia_btn_out"
        android:gravity="center"
        android:text="−"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:contentDescription="Nuova spesa" />
    <TextView
        android:id="@+id/w_in"
        android:layout_width="44dp"
        android:layout_height="40dp"
        android:layout_marginStart="5dp"
        android:background="@drawable/lydia_btn_in"
        android:gravity="center"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:contentDescription="Nuova entrata" />
    <TextView
        android:id="@+id/w_tr"
        android:layout_width="44dp"
        android:layout_height="40dp"
        android:layout_marginStart="5dp"
        android:background="@drawable/lydia_btn_tr"
        android:gravity="center"
        android:text="⇄"
        android:textColor="#0B1020"
        android:textSize="19sp"
        android:textStyle="bold"
        android:contentDescription="Giroconto" />
</LinearLayout>
