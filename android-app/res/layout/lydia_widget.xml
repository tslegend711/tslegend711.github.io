<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Movimenti, una riga: logo, saldo del mese e tre pulsanti tondi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/lydia_widget_bg"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@mipmap/ic_launcher_round"
        android:contentDescription="Lydia" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saldo del mese"
            android:textColor="@color/lydia_w_gold"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1" />
        <TextView
            android:id="@+id/w_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+0 €"
            android:textColor="@color/lydia_w_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_out"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/lydia_btn_out"
        android:gravity="center"
        android:text="−"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:contentDescription="Nuova spesa" />
    <TextView
        android:id="@+id/w_in"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/lydia_btn_in"
        android:gravity="center"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:contentDescription="Nuova entrata" />
    <TextView
        android:id="@+id/w_tr"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/lydia_btn_tr"
        android:gravity="center"
        android:text="⇄"
        android:textColor="#2A1F05"
        android:textSize="19sp"
        android:textStyle="bold"
        android:contentDescription="Giroconto" />
</LinearLayout>
