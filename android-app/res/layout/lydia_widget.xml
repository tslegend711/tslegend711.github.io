<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Movimenti, una riga: mese e saldo a sinistra, tre azioni a destra. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/lydia_widget_bg"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView android:id="@+id/w_logo" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginEnd="10dp" android:src="@mipmap/ic_launcher_round" android:contentDescription="Lydia" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Questo mese" android:textColor="@color/lydia_w_muted" android:textSize="12.5sp" android:letterSpacing="0.01" android:maxLines="1" />
        <TextView android:id="@+id/w_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="+0 €" android:textColor="@color/lydia_w_text" android:textSize="23sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>

    <ImageView android:id="@+id/w_eye" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginEnd="10dp" android:background="@drawable/lydia_eye_bg" android:padding="7dp" android:src="@drawable/lydia_ic_eye" android:visibility="gone" android:contentDescription="Mostra gli importi" />

    <TextView android:id="@+id/w_out" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/lydia_btn_out" android:gravity="center" android:text="−" android:textColor="@color/lydia_w_neg" android:textSize="24sp" android:fontFamily="sans-serif-medium" android:contentDescription="Nuova spesa" />
    <TextView android:id="@+id/w_in" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="6dp" android:background="@drawable/lydia_btn_in" android:gravity="center" android:text="+" android:textColor="@color/lydia_w_pos" android:textSize="24sp" android:fontFamily="sans-serif-medium" android:contentDescription="Nuova entrata" />
    <TextView android:id="@+id/w_tr" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="6dp" android:background="@drawable/lydia_btn_tr" android:gravity="center" android:text="⇄" android:textColor="@color/lydia_w_gold" android:textSize="19sp" android:contentDescription="Giroconto" />
</LinearLayout>
