<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: backup Google e passaggio a un nuovo telefono -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="lydia_backup.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="lydia_backup.json" />
    </device-transfer>
</data-extraction-rules>
