<?xml version="1.0" encoding="utf-8"?>
<!-- Sfondo scuro quasi nero con la luce oro in alto, come il tema scuro dell'app -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#F20C0E13" /><corners android:radius="26dp" /></shape></item>
    <item><shape android:shape="rectangle"><gradient android:type="radial" android:centerX="0.5" android:centerY="0" android:gradientRadius="220dp" android:startColor="#33D4AF37" android:endColor="#00D4AF37" /><corners android:radius="26dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000" /><stroke android:width="1dp" android:color="#40E3BC4A" /><corners android:radius="26dp" /></shape></item>
</layer-list>
